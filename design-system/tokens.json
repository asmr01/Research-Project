{
  "$description": "Design tokens derived from the MSHS PowerPoint template (8d2a328c-MSHS_Template.potx) and the reference deck (DRAFT_MSHS_CGT_Manufacturing_Assessment.pptx). Colors are the source of truth for any deck, doc, or artifact built in this system.",
  "meta": {
    "system": "MSHS Presentation Design System",
    "aspectRatio": "16:9",
    "slideSize": { "width_in": 13.333, "height_in": 7.5, "width_emu": 12192000, "height_emu": 6858000 },
    "fontFamily": "Arial"
  },
  "color": {
    "brand": {
      "cyan":    { "value": "#00AEEF", "role": "Primary accent — eyebrows, divider rules, key highlights", "theme": "accent1" },
      "indigo":  { "value": "#221F72", "role": "Headlines, titles, primary text accent", "theme": "accent2" },
      "magenta": { "value": "#D80B8C", "role": "Sparing highlight / single call-out per slide", "theme": "accent3" },
      "lightBlue": { "value": "#7FD6F7", "role": "Chart fills, light accents", "theme": "accent4" },
      "violet":  { "value": "#908FB8", "role": "Quiet meta — page numbers, secondary labels", "theme": "accent5" },
      "lightPink": { "value": "#EB85C5", "role": "Chart fills, light accents", "theme": "accent6" }
    },
    "neutral": {
      "black":    { "value": "#000000", "theme": "dk1" },
      "white":    { "value": "#FFFFFF", "theme": "lt1" },
      "gray":     { "value": "#666666", "theme": "dk2" },
      "lightGray":{ "value": "#CCCCCC", "theme": "lt2" }
    },
    "working": {
      "$note": "Not in the theme file, but the colors the reference deck actually uses. Prefer these for real content.",
      "actionBlue":  { "value": "#0C7CB2", "role": "Source-link text, filled status pills" },
      "deepNavy":    { "value": "#002060", "role": "Step / ladder numerals" },
      "gradientBlue":{ "value": "#0067A8", "role": "Cover gradient overlay" },
      "inkStrong":   { "value": "#44515B", "role": "Body copy, card body text" },
      "inkMuted":    { "value": "#5B6B78", "role": "Lead-in lines, source captions" },
      "surface":     { "value": "#EEF2F5", "role": "Card / panel fill" },
      "hairline":    { "value": "#D7DEE3", "role": "Borders, dividers, neutral pill fill" }
    }
  },
  "type": {
    "$unit": "pt",
    "coverTitle":     { "size": 48, "weight": "bold", "color": "brand.indigo | neutral.white (on cover)" },
    "coverSubtitle":  { "size": 20, "weight": "regular", "range": [16, 24] },
    "eyebrow":        { "size": 11, "weight": "bold", "case": "upper", "tracking": true, "color": "brand.cyan" },
    "headline":       { "size": 20, "weight": "regular", "range": [20, 21], "color": "brand.indigo", "note": "The takeaway. Load-bearing element of every content slide." },
    "cardTitle":      { "size": 16, "weight": "bold", "denseSize": 12.5, "color": "brand.indigo" },
    "leadIn":         { "size": 12.5, "weight": "regular", "color": "working.inkMuted" },
    "body":           { "size": 14, "weight": "regular", "denseRange": [10.5, 12.5], "color": "working.inkStrong" },
    "pill":           { "size": 9.5, "weight": "bold", "case": "none", "color": "neutral.white (on actionBlue) | working.inkStrong (on hairline)" },
    "stepNumeral":    { "size": 18, "weight": "bold", "color": "working.deepNavy" },
    "sources":        { "size": 8, "weight": "regular", "color": "working.actionBlue (links) | working.inkMuted (labels)" },
    "pageNumber":     { "size": 10, "weight": "regular", "color": "brand.violet" }
  },
  "layout": {
    "$unit": "in",
    "margin": { "left": 0.6, "right": 0.6 },
    "contentWidth": 12.13,
    "eyebrowY": 0.34,
    "headlineY": 0.62,
    "dividerRuleY": 1.42,
    "dividerRuleHeight": 0.03,
    "contentBand": { "top": 1.7, "bottom": 6.7 },
    "sourcesFooterY": 6.85,
    "pageNumber": { "x": 12.5, "y": 7.08 },
    "twoColGrid": { "colA_x": 1.4, "colB_x": 7.6, "cardWidth": 4.9, "gutter": 0.8 }
  },
  "shape": {
    "cardRadius_in": 0.08,
    "pillRadius": "full",
    "dividerColor": "brand.cyan"
  }
}
